<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Capa de entrada: controllers, middleware, DI, Quartz. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Transacciones.WebApi</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Los avisos CS1591 (falta comentario XML) no deben romper el build -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Transacciones.Core\Transacciones.Core.csproj" />
    <ProjectReference Include="..\Transacciones.Services\Transacciones.Services.csproj" />
    <ProjectReference Include="..\Transacciones.Data\Transacciones.Data.csproj" />
    <ProjectReference Include="..\Transacciones.External\Transacciones.External.csproj" />
    <ProjectReference Include="..\Transacciones.CrossCutting\Transacciones.CrossCutting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Newtonsoft con ReferenceLoopHandling.Ignore (ver Program.cs) -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.*" />

    <!-- OpenAPI: en net8 el soporte NO viene en caja, se agrega el paquete.
         A partir de .NET 9 se usa Microsoft.AspNetCore.OpenApi. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />

    <!--
      AutoMapper 15.1.1 — la PRIMERA version parcheada de CVE-2026-32933 (DoS por
      recursion sin limite: StackOverflowException que mata el proceso).
      AutoMapper 14.0.0 y anteriores SIGUEN VULNERABLES y no tienen parche gratuito.
      A partir de la 15 hay que registrar la licencia comercial; la clave se lee de
      configuracion ("AutoMapper:LicenseKey"). Alternativa MIT sin licencia:
      Riok.Mapperly.
    -->
    <PackageReference Include="AutoMapper" Version="15.1.1" />

    <!-- Quartz -->
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.*" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.*" />

    <!-- Logs -->
    <PackageReference Include="NLog" Version="5.*" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.*" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.*" />

    <!-- Clientes HTTP externos con Polly -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.*" />

    <!-- Health checks contra la base -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>