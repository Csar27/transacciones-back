<?xml version="1.0" encoding="utf-8"?>
<!--
  NLog escribe en consola y en fichero. El target de fichero esta en un
  appender asíncrono (`asyncWrapper`) para que una disco lento no bloquee
  las peticiones: los targets sincronos en el camino critico son una causa
  habitual de caidas que no aparecen en el profiler de CPU.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwExceptions="false"
      internalLogToConsole="true">
  <!--
    internalLogToConsole en "true" a proposito: si NLog no puede cargar esta
    configuracion, escribe POR QUE en la consola. Con "false" el fallo era
    completamente silencioso, y la consola se quedaba vacia justo cuando hacia
    falta ver la excepcion. Un logger que falla en silencio es peor que no
    tener logger.
  -->

  <extensions>
    <add assembly="NLog.Extensions.Logging" />
  </extensions>

  <!--
    Dos carpetas de log a proposito.

    ${basedir} es la carpeta de salida del binario, que cambia con la
    configuracion (Debug/Release) y con donde se publique. Con un unico destino
    relativo, si la API arranca desde un sitio distinto no aparece ningun log y
    no hay forma de encontrar la excepcion. El segundo destino sube cuatro
    niveles —bin/<Config>/net8.0 — y cae siempre junto a la solucion.

    El segundo destino se puede quitar cuando la ruta de despliegue sea fija.
  -->
  <variable name="logDirectory" value="${basedir}/logs" />
  <variable name="logRaiz" value="${basedir}/../../../../logs" />

  <targets>
    <target xsi:type="Console"
            name="consola"
            layout="${longdate}|${pad:padding=5,inner=${processid}}|${level:uppercase=true:padding=-5}|${logger}|${message} ${exception:format=ToString}" />

    <target xsi:type="File"
            name="archivo"
            fileName="${logDirectory}/transacciones-${shortdate}.log"
            layout="${longdate}|${pad:padding=5,inner=${threadid}}|${level:uppercase=true:padding=-5}|${logger}|${message} ${exception:format=ToString}"
            archiveEveryDay="true"
            archiveAboveSize="104857600"
            maxArchiveFiles="30"
            keepFileOpen="false"
            createDirs="true"
            encoding="utf-8" />

    <!-- El mismo log, junto a la solucion. Ver la nota de las variables. -->
    <target xsi:type="File"
            name="archivoRaiz"
            fileName="${logRaiz}/transacciones-${shortdate}.log"
            layout="${longdate}|${pad:padding=5,inner=${threadid}}|${level:uppercase=true:padding=-5}|${logger}|${message} ${exception:format=ToString}"
            archiveEveryDay="true"
            keepFileOpen="false"
            createDirs="true"
            encoding="utf-8" />

    <!-- Buffer en memoria que se vuelca cada 500 ms. -->
    <target xsi:type="AsyncWrapper"
            name="asyncArchivo"
            queueLimit="5000"
            overflowAction="Grow"
            batchSize="100"
            timeToSleepBetweenBatches="500">
      <target xsi:type="target" name="archivo" />
      <target xsi:type="target" name="archivoRaiz" />
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="consola,asyncArchivo" />
  </rules>

</nlog>